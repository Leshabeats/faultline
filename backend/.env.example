# Local-first Faultline API. Copy to backend/.env; config.Load reads it automatically.
# Process environment variables still win over this file.
FAULTLINE_ENV=development
FAULTLINE_HTTP_ADDR=127.0.0.1:8787
FAULTLINE_SQLITE_PATH=./data/faultline.db
FAULTLINE_PUBLIC_SHARE_BASE=http://127.0.0.1:4173
FAULTLINE_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
FAULTLINE_MAX_BODY_BYTES=1100000
FAULTLINE_RATE_LIMIT_PER_MINUTE=30
